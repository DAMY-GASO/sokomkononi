# ============================================================
# SokoMkononi Frontend — Environment Variables
# Copy to .env (dev) and .env.production (prod), then fill in.
# ============================================================

# --- API -----------------------------------------------------
# In production nginx proxies /api → backend, so keep "/api".
# For local dev, point at your Django dev server, e.g.
#   VITE_API_BASE_URL=http://localhost:8000/api
VITE_API_BASE_URL=/api

# --- Secret admin path --------------------------------------
VITE_ADMIN_PATH=/smk-control-9x7k

# --- Payments ------------------------------------------------
# true  → PaymentGateway returns a simulated success without
#         calling any external gateway. Backend endpoints still
#         get called so listing/boost/bundle states progress.
# false → real gateway (must be wired by backend team).
VITE_PAYMENT_SIMULATION=true

# --- Social auth (optional) ---------------------------------
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
VITE_FACEBOOK_APP_ID=
